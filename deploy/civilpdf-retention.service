[Unit]
Description=CivilPDF-DX retention / GDPR deletion pass (archive expiries + purge requested deletions)
Documentation=https://github.com/Kensan196948G/CivilPDF-DX
After=civilpdf-backup.service

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/Mirai-DX-Project/CivilPDF-DX
EnvironmentFile=%h/.config/civilpdf/civilpdf.env
ExecStart=/usr/bin/env python3 %h/Projects/Mirai-DX-Project/CivilPDF-DX/scripts/retention-job.py --apply --grace-days 30 --json

NoNewPrivileges=true

[Install]
WantedBy=default.target
