# CivilPDF-DX environment variables
# Copy to civilpdf.env and fill in real values.
# NEVER commit civilpdf.env to git.

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://civildx:CHANGE_ME@localhost:5432/civildx

# ── Security ────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_generate_with__openssl_rand_-hex_32

# ── CORS ────────────────────────────────────────────────────
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","https://your-domain.example.com"]

# ── File uploads ────────────────────────────────────────────
UPLOAD_DIR=/var/lib/civildx/uploads

# ── AI (optional) ───────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Microsoft 365 (optional) ────────────────────────────────
# M365_TENANT_ID=
# M365_CLIENT_ID=
# M365_CLIENT_SECRET=

# ── App Distribution ─────────────────────────────────────────
# Base URL of the GitHub Releases asset folder for CivilPDF-Editor.
# When set, /api/v1/apps/download/* returns real download URLs (available=true).
# When empty, all packages show available=false ("準備中" on the UI).
# Format: https://github.com/<owner>/<repo>/releases/download/<tag>
APPS_RELEASE_BASE_URL=https://github.com/Kensan196948G/CivilPDF-Editor/releases/download/v1.1.0

# Optional per-package SHA-256 checksums (shown on the download page).
# Obtain from `sha256sum <installer-file>` after downloading the release assets.
# APPS_SHA256_WIN_EXE=
# APPS_SHA256_WIN_MSI=
# APPS_SHA256_MAC_DMG=
# APPS_SHA256_LINUX_DEB=
# APPS_SHA256_LINUX_APPIMAGE=
# APPS_SHA256_LINUX_RPM=

# Optional build metadata (injected by CI; safe to leave empty in dev).
# APPS_BUILD_COMMIT=
# APPS_BUILD_DATE=
# APPS_BUILD_NUMBER=
